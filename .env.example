DATABASE_URL=postgresql://trove:trove_local@localhost:5434/trove?schema=public&connection_limit=10
DIRECT_URL=postgresql://trove:trove_local@localhost:5434/trove?schema=public
APP_URL=http://localhost:3000
# Explicit local demo: fixture accounts, deterministic planner, simulated purchases.
TROVE_DEMO_ENABLED=true
TROVE_SIMULATION_ENABLED=true
# Generate with: openssl rand -hex 32. Required outside local development.
RESULT_ENCRYPTION_KEY=
# Sandbox only. Real PayPal flows remain unavailable until these are configured.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYOUTS_ENABLED=false
SELLER_PRICING_PAYOUT_EMAIL=
SELLER_SUPPLIERS_PAYOUT_EMAIL=
SELLER_MARKET_PAYOUT_EMAIL=
# Optional live planner; no key means an explicitly labelled deterministic demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Shared daily API-call allowance, not a promise of provider quota. No paid fallback.
GEMINI_DAILY_REQUEST_LIMIT=30
# Use embedded on a single free web service; standalone with npm run worker locally.
TROVE_JOB_MODE=standalone
# Generate with: openssl rand -hex 32. Used only by protected hosted maintenance.
CRON_SECRET=
# Optional Elastic; database search remains available and accurately labelled.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=trove-offers
RESULT_RETENTION_HOURS=24
PLATFORM_COMMISSION_BPS=1000
