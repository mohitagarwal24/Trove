DATABASE_URL=postgresql://trove:trove_local@localhost:5434/trove?schema=public&connection_limit=10
DIRECT_URL=postgresql://trove:trove_local@localhost:5434/trove?schema=public
APP_URL=http://localhost:3000
# Google OAuth web application; optional until credentials are supplied.
# Redirect URI: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once: openssl rand -hex 32. Preserve across redeploys.
RESULT_ENCRYPTION_KEY=
# Sandbox uses fictitious funds. Live requires a separately approved merchant setup.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYOUTS_ENABLED=false
# Free Tier project with billing disabled. No paid-model fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DAILY_REQUEST_LIMIT=30
# Free HTTPS email delivery for signup verification and password recovery.
# Full setup: docs/GOOGLE_AUTH_SETUP.md. Unverified accounts cannot access workspaces.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=
# embedded for one free hosted service; standalone with npm run worker locally.
TROVE_JOB_MODE=standalone
# Generate separately: openssl rand -hex 32.
CRON_SECRET=
# Optional. PostgreSQL search works without Elasticsearch.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=trove-offers
RESULT_RETENTION_HOURS=24
PLATFORM_COMMISSION_BPS=1000
