{
  "info": {
    "name": "Trove \u2014 private accounts and scoped purchases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use your own private account values in a private environment. Cookie jar persists session. No simulation or shared passwords. Run Discovery first. Financial requests reserve an exact purchase; complete human PayPal approval in a browser signed into the same account before fetching result/receipt. Never export secrets."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "name",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "offerVersionId",
      "value": ""
    },
    {
      "key": "quoteId",
      "value": ""
    },
    {
      "key": "purchaseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Discovery and account",
      "item": [
        {
          "name": "Register private account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search public offer metadata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/offers?q=Drug%20approval"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));",
                  "const offers = pm.response.json().offers; if (offers.length) pm.collectionVariables.set('offerVersionId', offers[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create exact quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/quotes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerIds\": [\n    \"{{offerVersionId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));",
                  "pm.collectionVariables.set('quoteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read approved quote scope",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/quotes/{{quoteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find data for agent requirements",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/discovery",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Drug approval research\",\n  \"needs\": [\n    {\n      \"category\": \"Drug approvals\",\n      \"fields\": [\n        \"brand_name\",\n        \"active_ingredients\"\n      ],\n      \"quantity\": 10,\n      \"maxAgeDays\": 3650,\n      \"filters\": []\n    }\n  ],\n  \"purpose\": \"ai_inference\",\n  \"budgetCents\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "PayPal \u2014 manual buyer approval required",
      "item": [
        {
          "name": "Create purchase for browser approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quoteId}}\",\n  \"idempotencyKey\": \"postman:{{quoteId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));",
                  "const p = pm.response.json().purchase; pm.collectionVariables.set('purchaseId', p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read purchase after manual approval",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read entitled result",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}/result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read receipt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}/receipt"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
