{
  "info": {
    "name": "Trove — bounded research purchases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Guided simulation with a locally running app and worker. Simulation does not call PayPal. The Sandbox folder requires configured credentials and explicit buyer approval in the browser. No secrets are included."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "quoteId",
      "value": ""
    },
    {
      "key": "purchaseId",
      "value": ""
    },
    {
      "key": "sandboxPurchaseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Guided simulation — no PayPal transaction",
      "item": [
        {
          "name": "Sign into fixture buyer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/demo",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"buyer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search free metadata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/offers?q=current%20retail"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Plan scoped research",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Compare current product prices and supplier capabilities for internal business analysis.\",\n  \"budgetCents\": 1000,\n  \"mode\": \"demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));",
                  "pm.collectionVariables.set('quoteId',pm.response.json().quote.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create simulated purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quoteId}}\",\n  \"mode\": \"simulation\",\n  \"idempotencyKey\": \"postman-sim-{{quoteId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));",
                  "pm.collectionVariables.set('purchaseId',pm.response.json().purchase.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Explicit simulated approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}/simulate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"success\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read independent states",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve entitled data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}/result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download receipt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}/receipt"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sandbox — requires credentials and manual browser approval",
      "item": [
        {
          "name": "Find current supplier offer version",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/offers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const offer = pm.response.json().offers.find(o => o.offerId === 'atlas-directory'); pm.expect(offer).to.exist; pm.collectionVariables.set('supplierOfferVersionId',offer.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create fresh exact quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/quotes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerIds\": [\n    \"{{supplierOfferVersionId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));",
                  "pm.collectionVariables.set('quoteId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reserve sandbox purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quoteId}}\",\n  \"mode\": \"sandbox\",\n  \"idempotencyKey\": \"postman-sandbox-{{quoteId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));",
                  "pm.collectionVariables.set('sandboxPurchaseId',pm.response.json().purchase.id); console.log('Open the returned approvalUrl and approve using a sandbox buyer.');"
                ]
              }
            }
          ]
        },
        {
          "name": "Check after browser approval and worker fulfilment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{sandboxPurchaseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve purchased sandbox result",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{sandboxPurchaseId}}/result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Refund a concrete simulated purchase",
      "item": [
        {
          "name": "Request full refund",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}/refund",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman simulation refund verification\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inspect asynchronous refund status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              }
            ],
            "url": "{{baseUrl}}/api/purchases/{{purchaseId}}/receipt"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
