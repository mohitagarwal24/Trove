  "narrative": {
    "northStar": "The Source Workspace",
    "overview": "Trove places source evidence and the next decision inside a quiet, precise interface. White fields, pale neutral navigation, fine rules and compact Inter typography adapt the user’s chosen Attio references to a working research marketplace. The Trove name, mark, actual catalogue and account flows remain the identity and content.\n\nThe public page gives product evidence room to breathe; the application uses the same material at higher density. Restrained blue identifies focus and selected scope, while charcoal carries primary actions. The dark connection passage is a bounded procedural illustration, never a financial status display.",
    "keyCharacteristics": [
      "White and pale gray surfaces separated by fine rules.",
      "Charcoal primary actions and restrained blue focus and selection.",
      "Locally hosted Inter across public and working surfaces.",
      "Divided source inventory, explicit scope and tabular USD amounts.",
      "Compact sample records with readable fields and named native disclosures for supporting detail.",
      "Native scrolling, readable fallback content and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Action Hierarchy Rule",
        "body": "Charcoal carries primary decisions; blue supports focus, links and selection. Status colors communicate actual state and always retain text.",
        "section": "colors"
      },
      {
        "name": "The Stable Amount Rule",
        "body": "Use tabular numerals and explicit USD context for prices, limits and totals.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Use pale fills and fine borders to group ordinary content. Reserve stronger shadows for floating controls and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain readable source rights, attribution, scope and independent payment and delivery states at the point of decision.",
      "Do show human field and purpose labels while preserving submitted API values.",
      "Do stack actions beneath content when a narrow viewport needs the reading width.",
      "Do preserve visible focus, native disclosures and static reduced-motion content."
    ],
    "donts": [
      "Don’t transfer reference logos, CRM content, testimonials or customer metrics into Trove.",
      "Don’t restore the superseded ink rail, cobalt primary actions, amber marketing accents or Manrope display system.",
      "Don’t use ornamental eyebrows or miniature evidence text as reusable primitives.",
      "Don’t illustrate a successful model request, payment or entitlement as though it happened."
    ]
  }
