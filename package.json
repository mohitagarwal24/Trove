{
  "name": "trove",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "mcp": "node scripts/mcp-bridge.mjs",
    "test": "tsx --env-file=.env --test tests/*.test.ts",
    "test:browser": "playwright test",
    "search:index": "tsx --env-file-if-exists=.env scripts/index-search.ts",
    "check:integrations": "tsx --env-file-if-exists=.env scripts/check-integrations.ts",
    "start:hosted": "node --env-file-if-exists=.env scripts/hosted-start.mjs",
    "data:sync": "tsx --env-file-if-exists=.env scripts/sync-data.ts",
    "provider:review": "tsx --env-file-if-exists=.env scripts/review-provider.ts"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.5.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.3.1",
    "google-auth-library": "11.3.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
